DATABASE_URL=postgresql+psycopg2://youruser:yourpassword@localhost:5432/yourdbname
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=1440
TEST_DATABASE_URL=postgresql+psycopg2://youruser:yourpassword@localhost:5432/yourdbname_test

# development or production
ENVIRONMENT=development
# JSON list of exact frontends allowed to call the API
CORS_ORIGINS=["http://localhost:5173"]
